# =============================================================================
# TURTLE .gitignore — PlatformIO / ESP32 / painlessMesh
# =============================================================================

# --- PlatformIO ---
.pio/
.pioenvs/
.piolibdeps/
.piobuild/

# --- VSCode ---
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.vscode/settings.json

# Keep extensions.json (useful for team sharing)
# !.vscode/extensions.json

# --- Build artifacts ---
build/
*.o
*.elf
*.bin
*.hex
*.map
*.d

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# --- Python (if you add helper scripts) ---
__pycache__/
*.pyc
*.pyo
.env
venv/
.venv/

# --- Logs & debug ---
*.log
crash_reports/

# --- Secrets (NEVER commit WiFi creds or keys) ---
secrets.h
secrets.ini
credentials.h
.env.local

# --- Node / web UI tooling (if added later) ---
node_modules/
dist/
